# Copy this file to .env and fill in the ONE required value.
#
# All data sources are OPEN: no registration, no API keys, no IP binding.
#   - Weather + marine : Open-Meteo            (https://open-meteo.com)
#   - SST + chlorophyll: NOAA CoastWatch ERDDAP (https://coastwatch.pfeg.noaa.gov/erddap)
# Only the LLM needs a key.

# --- LLM (OpenAI-compatible) - unchanged ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Open data sources (defaults are fine; override only to self-host/mirror) ---
OPEN_METEO_BASE=https://api.open-meteo.com
OPEN_METEO_MARINE_BASE=https://marine-api.open-meteo.com
ERDDAP_BASE=https://coastwatch.pfeg.noaa.gov/erddap

APP_ENV=development
